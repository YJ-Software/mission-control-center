# OpenClaw Gateway
# Token is auto-detected from ~/.openclaw/openclaw.json if not set here
OPENCLAW_GATEWAY_WS=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_HTTP=http://127.0.0.1:18789
OPENCLAW_TOKEN=your-gateway-token-here

# Hermes Agent (opt-in). By default MCC uses the native API on localhost
# and reads API_SERVER_KEY from the Hermes profile's .env.
# MCC_AGENT_RUNTIME=hermes
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_HOME=
# HERMES_HOME defaults to the current user's .hermes directory.
# HERMES_API_KEY=...
# HERMES_BIN=...
# HERMES_INSTALL_DIR=...

# Authentication
AUTH_PASSWORD=your-dashboard-password-here
AUTH_SECRET=generate-a-random-string-here

# Server
PORT=3737
HOST=127.0.0.1
